#!/usr/bin/env python3

import grp
import os
import pwd
import shutil
import sys

from pathlib import Path

repo   = Path(__file__).resolve().parent
target = Path("/")

for line in (repo / "Manifest").read_text().splitlines():
  line = line.strip()
  if not line or line.startswith('#'):
    continue

  path, owner, group, mode = line.split()

  src = repo   / path
  dst = target / path

  permissions = 0
  for bits in (mode[1:4], mode[4:7], mode[7:10]):
    permissions = (permissions << 3) | sum(
      value for char, value in zip(bits, (4, 2, 1))
      if char in "rwx"
    )

  uid = pwd.getpwnam(owner).pw_uid
  gid = grp.getgrnam(group).gr_gid

  print(f"{dst} mode={permissions:04o} uid={uid} gid={gid}")

  if mode[0] == 'd': dst.mkdir(exist_ok=True)
  elif mode[0] == '-': shutil.copyfile(src, dst)

  os.chown(dst, uid, gid)
  os.chmod(dst, permissions)
