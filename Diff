#!/usr/bin/env python3

import argparse
import subprocess

from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("-r", "--reverse", action="store_true")
args = parser.parse_args()

repo   = Path(__file__).resolve().parent
target = Path("/")

for line in (repo / "Manifest").read_text().splitlines():
  line = line.strip()
  if not line or line.startswith('#'):
    continue

  path, owner, group, mode = line.split()

  if mode[0] != '-':
    continue

  src = repo   / path
  dst = target / path

  old, new = (src, dst) if args.reverse else (dst, src)

  subprocess.run([
    "diff", "-u",
    "--label", old if old.exists() else "/dev/null",
    "--label", old,
    old if old.exists() else "/dev/null",
    new if new.exists() else "/dev/null",
  ])
